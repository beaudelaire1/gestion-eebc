# Clé distincte de SECRET_KEY utilisée pour chiffrer les secrets TOTP en base.
# OBLIGATOIRE avec DEBUG=False. Elle doit rester stable après mise en production.
# Exemple de génération: python -c "import secrets; print(secrets.token_urlsafe(48))"
TWO_FACTOR_ENCRYPTION_KEY=remplacer-par-une-cle-aleatoire-longue-et-stable

