# =============================================================================
# CONFIGURATION GESTION EEBC
# Copiez ce fichier en .env pour le développement local. En production Coolify,
# renseignez les variables dans l'interface Coolify et ne commitez aucun secret.
# =============================================================================

# Django
DEBUG=True
SECRET_KEY=change-me-with-a-stable-secret-at-least-32-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Derrière Coolify/Traefik, conserver le port applicatif privé et laisser
# X-Forwarded-Proto déterminer HTTPS côté Django.
GUNICORN_FORWARDED_ALLOW_IPS=*

# =============================================================================
# CONFIGURATION EMAIL
# =============================================================================
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application

# Configuration Hostinger Email
HOSTINGER_API_KEY=votre-cle-api-hostinger
HOSTINGER_EMAIL_HOST=smtp.hostinger.com
HOSTINGER_EMAIL_PORT=587
HOSTINGER_EMAIL_USE_TLS=True
HOSTINGER_EMAIL_USE_SSL=False
HOSTINGER_EMAIL_HOST_USER=votre-email@votre-domaine.com
HOSTINGER_EMAIL_HOST_PASSWORD=votre-mot-de-passe-email
HOSTINGER_EMAIL_TIMEOUT=30
HOSTINGER_EMAIL_MAX_RETRIES=3
HOSTINGER_API_BASE_URL=https://developers.hostinger.com

DEFAULT_FROM_EMAIL=EEBC <noreply@eebc.org>
EMAIL_FROM_NAME=EEBC

# =============================================================================
# CELERY / CACHE PARTAGÉ
# =============================================================================
# Obligatoire en production. Redis est partagé par le cache, le rate limiting,
# les sessions mises en cache et Celery.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
# Production : privilégier DATABASE_URL fourni par la ressource PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/eebc_db

# Alternative : toutes les variables ci-dessous sont requises lorsqu'aucun
# DATABASE_URL n'est fourni.
# DB_NAME=eebc
# DB_USER=eebc
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# STOCKAGE MÉDIA PERSISTANT
# =============================================================================
# Choix supportés en production : cloudinary ou s3.
MEDIA_STORAGE_BACKEND=cloudinary

# Option A - Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option B - S3 compatible / OVH Object Storage
# MEDIA_STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://s3.<region>.io.cloud.ovh.net
# AWS_S3_REGION_NAME=<region>
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_CUSTOM_DOMAIN=
# AWS_LOCATION=media

# =============================================================================
# STRIPE
# =============================================================================
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:8000/don/succes/
STRIPE_CANCEL_URL=http://localhost:8000/don/annule/

# =============================================================================
# TWILIO
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+594XXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+14155238886

# =============================================================================
# META WHATSAPP CLOUD API
# =============================================================================
META_WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
META_WHATSAPP_VERIFY_TOKEN=votre-token-webhook
META_WHATSAPP_APP_SECRET=votre-app-secret-meta
META_WHATSAPP_API_VERSION=v23.0
META_WHATSAPP_ANNOUNCEMENT_TEMPLATE=eebc_announcement
META_WHATSAPP_TEMPLATE_LANGUAGE=fr

# =============================================================================
# CAPTCHA - Cloudflare Turnstile
# =============================================================================
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google reCAPTCHA v3 (legacy)
RECAPTCHA_PUBLIC_KEY=6xxxxxxxxxxxxxxxxxxxx
RECAPTCHA_PRIVATE_KEY=6xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SENTRY
# =============================================================================
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# =============================================================================
# SESSION & SÉCURITÉ RÉSEAU
# =============================================================================
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Plateforme fournissant un header client dédié et non falsifiable : actuellement
# seul HTTP_CF_CONNECTING_IP est accepté par l'application.
# TRUSTED_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP

# Hors de ce cas, X-Forwarded-For n'est accepté que si REMOTE_ADDR appartient
# aux CIDR de proxy explicitement approuvés. Sur Coolify, renseigner le subnet
# réel du réseau Traefik après inspection du serveur.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# Ne jamais utiliser : 0.0.0.0/0 ou ::/0.

# =============================================================================
# CONFIGURATION SITE & ÉGLISE
# =============================================================================
SITE_URL=http://localhost:8000
SITE_NAME=EEBC
SITE_DESCRIPTION=Église Évangélique Baptiste de Cabassou
CHURCH_SIRET=12345678901234
CHURCH_RNA=W123456789
CHURCH_PHONE=+594 (0) 594 XX XX XX
CHURCH_EMAIL=contact@eglise-ebc.org
META_DESCRIPTION=Église Évangélique Baptiste de Cabassou - Guyane
OG_IMAGE_URL=http://localhost:8000/static/img/og-image.png
FACEBOOK_URL=https://facebook.com/egliseebc
YOUTUBE_URL=https://youtube.com/@egliseebc
INSTAGRAM_URL=https://instagram.com/egliseebc

# =============================================================================
# CONFIGURATION MÉTIER
# =============================================================================
MEMBER_VISIT_THRESHOLD_DAYS=180
RECURRING_ABSENCE_THRESHOLD=3
ROLE_ASSIGNMENT_EXPIRY_HOURS=48
DEFAULT_NOTIFICATION_DAYS_BEFORE=4
DEFAULT_NOTIFICATION_DAY=3
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
MAX_FINANCIAL_AMOUNT=1000000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# BACKUP LOCAL / OUTILS MANUELS
# =============================================================================
# Ce mécanisme historique ne remplace pas une sauvegarde PostgreSQL moteur.
# Sur Coolify, utiliser les Scheduled Backups PostgreSQL avec copie S3.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DÉVELOPPEMENT UNIQUEMENT
# =============================================================================
DEBUG_TOOLBAR=False
LOGGING_LEVEL=INFO
